component Rating(value = "0", label = "", size = "") {
  return ASX {
    <div class="ax-rating" data-size={size} aria-label={label}>
      <span class="ax-rating__stars" data-value={value}>★★★★★</span>
      <If when={label}>
        <span class="ax-rating__label">{label}</span>
      </If>
    </div>
  }
}

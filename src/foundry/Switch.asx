component Switch(name = "", checked = "", disabled = "") {
  return ASX {
    <label class="ax-switch" data-checked={checked} data-disabled={disabled}>
      <input type="checkbox" name={name} checked={checked == "true"} disabled={disabled == "true"} />
      <span class="ax-switch__track">
        <span class="ax-switch__thumb"></span>
      </span>
      <span>
        <Slot />
      </span>
    </label>
  }
}

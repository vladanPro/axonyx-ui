{
  "name": "@axonyx/ui",
  "version": "0.0.82",
  "description": "Framework-agnostic CSS and JS package for Axonyx UI Foundry.",
  "license": "MIT",
  "homepage": "https://axonyx.dev",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/js/*.js"
  ],
  "exports": {
    "./css/index.css": "./dist/css/index.css",
    "./css/foundry.css": "./dist/css/foundry.css",
    "./foundry/*": "./dist/foundry/*",
    "./blocks/*": "./dist/blocks/*",
    "./registry": "./dist/Axonyx.registry.toml",
    "./js/index": "./dist/js/index.js",
    "./js/tabs": "./dist/js/tabs.js",
    "./js/dialog": "./dist/js/dialog.js",
    "./js/drawer": "./dist/js/drawer.js",
    "./js/code-copy": "./dist/js/code-copy.js",
    "./js/command": "./dist/js/command.js",
    "./brand/*": "./dist/brand/*"
  },
  "files": [
    "dist",
    "docs/foundry-finish.md",
    "docs/component-coverage.md",
    "docs/browser-qa.md",
    "docs/customization.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "audit:coverage": "node scripts/audit-component-coverage.mjs --write",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:customization": "node scripts/customization-qa.mjs",
    "test:form-geometry": "node scripts/form-geometry-qa.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "playwright": "1.60.0"
  },
  "keywords": [
    "axonyx",
    "ui",
    "css",
    "design-system",
    "foundry",
    "web-components",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladanPro/axonyx-ui.git"
  }
}
